From c3186e59bb90686136110aec5bcceb973607919d Mon Sep 17 00:00:00 2001
From: Haowen Liu <liu.haowen.andy@gmail.com>
Date: Sun, 13 Sep 2026 14:08:04 -0400
Subject: [PATCH] Fix CMake detection of HAV_VSNPRINTF_DECL

The CMake setup in this version does not properly detect this macro and
will fail on newer glibc.
---
 include/wx/wxcrtvararg.h | 9 ---------
 1 file changed, 9 deletions(-)

diff --git a/include/wx/wxcrtvararg.h b/include/wx/wxcrtvararg.h
index 36aae29957..67b1b59223 100644
--- a/include/wx/wxcrtvararg.h
+++ b/include/wx/wxcrtvararg.h
@@ -36,15 +36,6 @@
  */
 #ifdef __UNIX__
 
-#if defined(HAVE_VSNPRINTF) && !defined(HAVE_VSNPRINTF_DECL)
-#ifdef __cplusplus
-    extern "C"
-#else
-    extern
-#endif
-    int vsnprintf(char *str, size_t size, const char *format, va_list ap);
-#endif /* !HAVE_VSNPRINTF_DECL */
-
 #if defined(HAVE_SNPRINTF) && !defined(HAVE_SNPRINTF_DECL)
 #ifdef __cplusplus
     extern "C"
-- 
2.53.0

